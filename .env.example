# =========================================================================
# FORMASEO ACADÉMIE — ENVIRONMENT VARIABLES CONFIGURATION TEMPLATE
# =========================================================================
# Copy this file to .env and fill in the values appropriate for your environment.
# NEVER commit .env to version control.

# Node Environment ('development' | 'production')
NODE_ENV=development

# Server Port
PORT=5001

# Allowed Client Origin for CORS
CLIENT_ORIGIN=http://localhost:5173

# Server-Side JWT Secret (Mandatory in production: minimum 32 random characters)
JWT_SECRET=

# PostgreSQL Database Connection String (Supabase / Neon / AWS RDS / Local Postgres)
DATABASE_URL=

# CMI (Centre Monétique Interbancaire Maroc) Merchant Gateway Credentials
CMI_MERCHANT_ID=
CMI_STORE_KEY=
CMI_GATEWAY_URL=

# Development Seeding Passwords (Used only in development environment)
DEV_ADMIN_PASSWORD=
DEV_STUDENT_PASSWORD=
